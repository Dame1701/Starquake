<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="using:Starquake.ScreenEditor.Styles"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="Starquake.ScreenEditor.App"
             RequestedThemeVariant="Dark">
    <!--
        The editor is fixed to the dark variant rather than following the system. It is a window
        full of pixel art on a dark background, and a light chrome around that reads as a mistake
        rather than a preference.
    -->

    <Application.Resources>
        <!-- One source of truth for the palette; see EditorColours. -->
        <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{x:Static styles:EditorColours.Background}" />
        <SolidColorBrush x:Key="EditorPanelBrush" Color="{x:Static styles:EditorColours.Panel}" />
        <SolidColorBrush x:Key="EditorPanelRaisedBrush" Color="{x:Static styles:EditorColours.PanelRaised}" />
        <SolidColorBrush x:Key="EditorBorderBrush" Color="{x:Static styles:EditorColours.Border}" />
        <SolidColorBrush x:Key="EditorTextBrush" Color="{x:Static styles:EditorColours.Text}" />
        <SolidColorBrush x:Key="EditorMutedBrush" Color="{x:Static styles:EditorColours.Muted}" />
        <SolidColorBrush x:Key="EditorAccentBrush" Color="{x:Static styles:EditorColours.Accent}" />
        <SolidColorBrush x:Key="EditorAccentWashBrush" Color="{x:Static styles:EditorColours.AccentDim}"
                         Opacity="0.55" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://ScreenEditor/Styles/EditorTheme.axaml" />
    </Application.Styles>
</Application>
