<!--
  The game itself. Every platform builds from these sources, and none of them is
  platform-specific.

  One target framework and one MonoGame flavour, because every head is DesktopGL - Windows
  included. This project used to multi-target net10.0 and net10.0-windows so that the Windows
  head could have MonoGame.Framework.WindowsDX: the flavours share an assembly identity and
  cannot meet in one output folder, so a second target framework was the only way to build
  both. Moving Windows to DesktopGL removed the reason, and with it EnableWindowsTargeting,
  the WINDOWS compilation symbol, and the conditional content build. See BUILD.md.

  Program.cs is deliberately excluded: a .NET entry point has to be compiled into the
  executable itself, so each head links that one file in. See Starquake.Shared.props.
-->
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <RootNamespace>Starquake</RootNamespace>
        <AssemblyName>Starquake.Shared</AssemblyName>
        <TieredCompilation>false</TieredCompilation>
        <Nullable>enable</Nullable>
        <!-- Content.mgcb is named explicitly below; don't glob for it as well. -->
        <EnableMGCBItems>false</EnableMGCBItems>
        <!--
          The content's sources - the art, the sounds, the particle effect XML - are part of the
          project and worth seeing in it. What MGCB builds them into is not: Content.mgcb declares
          its own bin and obj next to the sources, so those two are excluded here rather than the
          whole of Content\. Excluding them as default items rather than removing them afterwards
          means MSBuild never enumerates the few hundred .xnb files in the first place.

          The last three are not content at all: .mgstats is MGCB's build report, written next to
          Content.mgcb rather than under its output folders; the other two are what an image editor and
          the Finder leave behind. All three are already in .gitignore, and this is the same list said
          to the project, so what it shows and what is tracked stay the same set.
        -->
        <DefaultItemExcludes>$(DefaultItemExcludes);Content\bin\**;Content\obj\**;**\.mgstats;**\*~;**\.DS_Store</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <!-- Compiled into each head instead, but kept visible here where it lives. -->
        <Compile Remove="Program.cs"/>
        <None Include="Program.cs"/>
        <!-- No code lives under Content; this keeps it that way if any ever appears. -->
        <Compile Remove="Content\**"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          GameHost is the only type a head needs to see, so it is the only public one in here;
          everything else the game is made of is internal. The tests reach past that rather than
          forcing a public surface to exist for their benefit: what they exercise - collision
          detection, the nasty brain, the world populator - is the inside of the game, and making
          it public would be describing it as an API that nothing outside this solution consumes.
        -->
        <InternalsVisibleTo Include="Starquake.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="Content\Fonts\elektoraSmall.spritefont">
            <SubType>Designer</SubType>
        </None>
        <!-- Screen data is read with a plain FileStream relative to the working directory,
             which Program.cs pins to the executable's folder. -->
        <None Update="Data\SQScreenData.dat">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ProjectMercury\ProjectMercury.csproj"/>
        <ProjectReference Include="..\SharedLibs\SharedLibs.csproj"/>
        <!--
          The Project Mercury MGCB extension. It is a build-time tool, not a dependency:
          this reference exists so `dotnet build` on a head restores and builds it, and
          every asset of it is kept out of the output. BuildContentPipelineExtension below
          is what actually gets it built early enough for the content build to use.
        -->
        <ProjectReference Include="..\ProjectMercury.ContentPipeline\ProjectMercury.ContentPipeline.csproj" ReferenceOutputAssembly="false" Private="false" ExcludeAssets="all"/>
        <PackageReference Include="MessagePack"/>
        <PackageReference Include="MonoGame.Content.Builder.Task"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          The content is built here, once, rather than in each head, and reaches each head's
          output through the project reference. There is one set of .xnb for every platform now:
          MGCB keys its output folder off the MonoGamePlatform that the MonoGame package sets,
          and with DesktopGL everywhere that is a single DesktopGL folder all three heads share.
          When WindowsDX was in the solution it was also a race to avoid - two heads on the same
          platform writing the same files - which no longer arises.

          Shaders need a compiler MonoGame does not ship. On Windows it uses the DirectX one
          already on the machine; on macOS and Linux it runs that same Windows compiler under
          Wine and wants MGFXC_WINE_PATH set. That is a requirement of the machine doing the
          build, not of the platform being built for. See BUILD.md.
        -->
        <MonoGameContentReference Include="Content\Content.mgcb" Condition="'$(PrebuiltContentDir)' == ''"/>
    </ItemGroup>

    <!--
      Content built elsewhere and handed in, which is how CI does it.

      Point PrebuiltContentDir at a folder of .xnb and the content build is skipped entirely;
      those files are copied to the output as if MGCB had just produced them. CI builds the
      content once on a Windows runner - the only one of the three with a shader compiler of its
      own - and the macOS and Linux publish jobs take it from there, so no runner needs the 450MB
      of Wine the alternative would cost on two platforms out of three.

      It is a path in, not a second source of truth: nothing is committed, and a build with the
      property unset compiles the content from Content.mgcb exactly as before.

      Every file, not just the .xnb. Most of the built content is .xnb and used to be all of it, but
      a song is not: MGCB writes the music out as an .ogg beside a tiny .xnb that names it, and the
      game reads the .ogg at play time. MGCB's own task copies whatever it finds in the output
      folder, so this takes the same view of a folder handed in.
    -->
    <ItemGroup Condition="'$(PrebuiltContentDir)' != ''">
        <Content Include="$(PrebuiltContentDir)\**\*.*">
            <Link>Content\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MonoGame.Framework.DesktopGL"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="Content\**"/>
    </ItemGroup>

    <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
        <Message Text="Restoring dotnet tools" Importance="High"/>
        <Exec Command="dotnet tool restore"/>
    </Target>

    <!--
      Content.mgcb references the Project Mercury pipeline extension so MGCB can compile
      the ParticleEffects XML. MGCB runs before project references are resolved, so build
      that extension here rather than relying on reference ordering. It is a net8.0 tool
      (MGCB's own runtime) and is never referenced by the game.
    -->
    <Target Name="BuildContentPipelineExtension" BeforeTargets="RunContentBuilder">
        <MSBuild Projects="..\ProjectMercury.ContentPipeline\ProjectMercury.ContentPipeline.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);TargetFramework=net8.0"/>
    </Target>

</Project>
