<!--
  The Project Mercury particle engine, used by the game at runtime and by MGCB at build
  time (it has to resolve ProjectMercury.ParticleEffect to compile the ParticleEffects
  XML into .xnb).

  That second consumer constrains the target framework: MGCB is a net8.0 tool, and it can
  load this as net10.0 only because Starquake.Shared runs it on the .NET 10 runtime. Take
  that away and every particle effect fails to compile.

  It references MonoGame.Framework.Native, the managed framework every head uses. That
  package is netstandard2.1, so it loads into MGCB and into the game alike.

  The 25 #if WINDOWS blocks through these sources are inert and always were: nothing here
  has ever defined that symbol. They are upstream XNA-era guards around [Serializable] and
  a Guard call, left as found.
-->
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <!--
          Off here alone. This is the Mercury particle engine, written in 2009, long before
          nullable reference types existed, and it is upstream code rather than ours: every
          field it leaves for Initialise to fill and every parameter it treats as optional
          reports against a standard it was never written to. Annotating it would be a large
          diff through third-party source and would make future comparison with upstream
          harder for no benefit to the game. Everything we do write keeps Nullable on.
        -->
        <Nullable>disable</Nullable>
        <RootNamespace>ProjectMercury</RootNamespace>
        <AssemblyName>ProjectMercury</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MonoGame.Framework.Native"/>
    </ItemGroup>

</Project>
