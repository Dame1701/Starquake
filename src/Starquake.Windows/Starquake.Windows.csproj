<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\Starquake.Shared\Starquake.Shared.props"/>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <RollForward>Major</RollForward>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Starquake.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Vulkan, the same as the Linux and macOS heads, and net10.0 rather than net10.0-windows
          because nothing here needs Windows Forms.

          The runtime package ships mgruntime.dll for win-x64 and win-arm64, with SDL inside
          it. vulkan-1.dll comes with the graphics driver. See BUILD.md.
        -->
        <PackageReference Include="MonoGame.Framework.Native"/>
        <PackageReference Include="MonoGame.Runtime.Windows.Vulkan"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          The window icon. MonoGame's NativeGameWindow looks for an embedded "Icon.bmp" in the
          entry assembly and falls back to its own MonoGame logo when there isn't one.

          ApplicationIcon stays: that is the icon Explorer draws on Starquake.exe itself, which
          is a different thing from the icon on the window. This is the square master, the same
          file the Linux head embeds; only macOS wants the art inset into a rounded body.
        -->
        <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp"/>
    </ItemGroup>
</Project>
