<!--
  NativeAOT, 64-bit Windows. See "Publishing ahead of time" in BUILD.md.

      dotnet publish Starquake.Windows\Starquake.Windows.csproj -p:PublishProfile=Aot-win-x64

  This one has to run on Windows, and for one reason rather than the two it used to have: ILC
  links through the MSVC toolchain, so it wants the Visual Studio C++ build tools. The content is
  no longer a reason - this head is DesktopGL now, and its .xnb build anywhere, Wine included.

  ILC itself is not the obstacle. Told to target another operating system it compiles the managed
  code happily and emits a valid object file for that target; it is the link that fails, for want
  of a linker that knows the other platform. See "Publishing ahead of time" in BUILD.md.
-->
<Project>
    <!--
      No TargetFramework here on purpose. Every project in the solution targets exactly one, so
      naming it would say nothing - and an IDE publishes a profile by passing its properties on
      the command line, where TargetFramework becomes a global property that reaches every
      project in the graph and overrides what each of them chose for itself. See the Gotchas
      section of BUILD.md.
    -->
    <PropertyGroup>
        <PublishProtocol>FileSystem</PublishProtocol>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishAot>true</PublishAot>
        <PublishDir>bin/Publish/win-x64/</PublishDir>
    </PropertyGroup>
</Project>
