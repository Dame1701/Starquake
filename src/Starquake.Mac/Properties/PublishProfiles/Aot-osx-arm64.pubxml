<!--
  NativeAOT, Apple Silicon. See "Publishing ahead of time" in BUILD.md.

      dotnet publish Starquake.Mac/Starquake.Mac.csproj -p:PublishProfile=Aot-osx-arm64

  NativeAOT does not cross-compile: this profile has to be run on a Mac.
-->
<Project>
    <!--
      No TargetFramework here on purpose. Every project in the solution targets exactly one, so
      naming it would say nothing - and an IDE publishes a profile by passing its properties on
      the command line, where TargetFramework becomes a global property that reaches every
      project in the graph and overrides what each of them chose for itself. See the Gotchas
      section of BUILD.md.
    -->
    <PropertyGroup>
        <PublishProtocol>FileSystem</PublishProtocol>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishAot>true</PublishAot>
        <PublishDir>bin/Publish/osx-arm64/</PublishDir>
    </PropertyGroup>
</Project>
