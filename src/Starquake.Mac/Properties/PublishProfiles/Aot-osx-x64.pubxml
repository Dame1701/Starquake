<!--
  NativeAOT, Intel Mac. See Aot-osx-arm64.pubxml; only the runtime identifier differs.
-->
<Project>
    <!--
      No TargetFramework here on purpose. Every project in the solution targets exactly one, so
      naming it would say nothing - and an IDE publishes a profile by passing its properties on
      the command line, where TargetFramework becomes a global property that reaches every
      project in the graph and overrides what each of them chose for itself. See the Gotchas
      section of BUILD.md.
    -->
    <PropertyGroup>
        <PublishProtocol>FileSystem</PublishProtocol>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>osx-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishAot>true</PublishAot>
        <PublishDir>bin/Publish/osx-x64/</PublishDir>
    </PropertyGroup>
</Project>
