<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\Starquake.Shared\Starquake.Shared.props"/>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
        <RollForward>Major</RollForward>
        <AppBundleDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/Starquake.app</AppBundleDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MonoGame.Framework.Native"/>
        <PackageReference Include="MonoGame.Runtime.Mac.Vulkan"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          The Dock icon while the game is running. MonoGame's NativeGameWindow looks for an
          embedded "Icon.bmp" in the entry assembly and falls back to its own MonoGame logo
          when there isn't one. SDL's macOS backend sets NSApplication's icon from it, which
          overrides Starquake.icns the moment the window opens - so this has to carry the same
          rounded shape as the bundle icon, not the square master the other heads use.
        -->
        <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp"/>
    </ItemGroup>

    <!--
      Wrap the build output in a Starquake.app bundle so the game launches from Finder with
      the right icon and menu bar name. The plain executable is still produced alongside it.
    -->
    <Target Name="CreateAppBundle" AfterTargets="Build"
            Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(PublishAot)' != 'true'">
        <PropertyGroup>
            <AppBundleMacOSDir>$(AppBundleDir)/Contents/MacOS</AppBundleMacOSDir>
            <AppBundleResourcesDir>$(AppBundleDir)/Contents/Resources</AppBundleResourcesDir>
        </PropertyGroup>

        <ItemGroup>
            <!-- Inside a bundle MonoGame resolves content against Contents/Resources, so the
                 built content goes there. Everything else, Data/*.dat included, goes in
                 Contents/MacOS: that is where Program.cs pins the working directory, and
                 the screen data is read with a plain FileStream relative to it. -->
            <AppBundleContent Include="$(OutputPath)Content\**\*.*"/>
            <AppBundleBinary Include="$(OutputPath)**\*.*"
                             Exclude="$(OutputPath)Starquake.app\**;$(OutputPath)Content\**;$(OutputPath)**\.DS_Store"/>
        </ItemGroup>

        <!--
          Deleted rather than copied over. Both copies below are additive and SkipUnchangedFiles
          leaves what is already there alone, so a file from an earlier run - another
          configuration's binary, or the apphost a non-AOT build leaves behind - survives every
          later one and ships inside the bundle with nothing to say so. Deleting first means a
          bundle holds what this run produced and only that.
        -->
        <RemoveDir Directories="$(AppBundleDir)"/>

        <MakeDir Directories="$(AppBundleMacOSDir);$(AppBundleResourcesDir)"/>
        <Copy SourceFiles="@(AppBundleBinary)"
              DestinationFiles="@(AppBundleBinary->'$(AppBundleMacOSDir)/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(AppBundleContent)"
              DestinationFiles="@(AppBundleContent->'$(AppBundleResourcesDir)/Content/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <!-- sed rather than Copy, to put <Version> into CFBundleShortVersionString and
             CFBundleVersion. This target is macOS-only, so sed is always there. -->
        <Exec Command="sed 's/__VERSION__/$(Version)/g' &quot;$(MSBuildProjectDirectory)/Info.plist&quot; &gt; &quot;$(AppBundleDir)/Contents/Info.plist&quot;"/>
        <Copy SourceFiles="Starquake.icns" DestinationFolder="$(AppBundleResourcesDir)" SkipUnchangedFiles="true"/>
        <Exec Command="chmod +x &quot;$(AppBundleMacOSDir)/Starquake&quot;"/>
        <!-- Ad-hoc signature: unsigned bundles are killed on launch on Apple Silicon. -->
        <Exec Command="codesign --force --deep --sign - &quot;$(AppBundleDir)&quot;"/>
        <Message Text="Built $(AppBundleDir)" Importance="High"/>
    </Target>

    <!--
      The same bundle again, around the publish output rather than the build output. A NativeAOT
      publish writes one native executable and libmgruntime.dylib to PublishDir and never touches
      bin/<Config>/<TFM>/, so the bundle CreateAppBundle makes is of the wrong thing entirely:
      it would hold a Starquake.dll and no runtime, and launching it does nothing.

      This is a second target rather than the first one parameterised because MSBuild runs a
      target once per project instance, and `dotnet publish` runs Build and Publish in the same
      one - so a single target cannot see both output folders. The only difference is where it
      copies from.
    -->
    <Target Name="CreateAotAppBundle" AfterTargets="Publish"
            Condition="'$(PublishAot)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">
        <PropertyGroup>
            <AotAppBundleDir>$(PublishDir)Starquake.app</AotAppBundleDir>
            <AotAppBundleMacOSDir>$(AotAppBundleDir)/Contents/MacOS</AotAppBundleMacOSDir>
            <AotAppBundleResourcesDir>$(AotAppBundleDir)/Contents/Resources</AotAppBundleResourcesDir>
        </PropertyGroup>

        <ItemGroup>
            <!-- The debug symbols are most of the publish folder and none of the game. -->
            <AotAppBundleContent Include="$(PublishDir)Content\**\*.*"/>
            <AotAppBundleBinary Include="$(PublishDir)**\*.*"
                                Exclude="$(PublishDir)Starquake.app\**;$(PublishDir)Content\**;$(PublishDir)**\*.pdb;$(PublishDir)**\*.dbg;$(PublishDir)*.xml;$(PublishDir)**\*.dSYM\**;$(PublishDir)**\.DS_Store"/>
        </ItemGroup>

        <!--
          Deleted rather than copied over. Both copies below are additive and SkipUnchangedFiles
          leaves what is already there alone, so a file from an earlier run - another
          configuration's binary, or the apphost a non-AOT build leaves behind - survives every
          later one and ships inside the bundle with nothing to say so. Deleting first means a
          bundle holds what this run produced and only that.
        -->
        <RemoveDir Directories="$(AotAppBundleDir)"/>

        <MakeDir Directories="$(AotAppBundleMacOSDir);$(AotAppBundleResourcesDir)"/>
        <Copy SourceFiles="@(AotAppBundleBinary)"
              DestinationFiles="@(AotAppBundleBinary->'$(AotAppBundleMacOSDir)/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(AotAppBundleContent)"
              DestinationFiles="@(AotAppBundleContent->'$(AotAppBundleResourcesDir)/Content/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>

        <!--
          The executable, taken from where ILC wrote it rather than from whatever the publish left
          at the publish root.

          Those are not always the same file. A publish run from an IDE has been seen to leave the
          apphost there - the 120KB launcher stub a JIT build uses to find Starquake.dll - instead
          of the native binary, and a bundle built around that starts, finds no managed assembly,
          and exits without a word. The copy above would carry it in faithfully. NativeBinary is
          what ILC actually produced, so this is the same answer however the publish was invoked,
          and it overwrites whatever the glob brought in.
        -->
        <Error Condition="'$(NativeBinary)' == '' or !Exists('$(NativeBinary)')"
               Text="A NativeAOT publish produced no native binary at '$(NativeBinary)'. Refusing to build an app bundle around the apphost, which would launch and do nothing."/>
        <Copy SourceFiles="$(NativeBinary)" DestinationFolder="$(AotAppBundleMacOSDir)"/>

        <!-- As in CreateAppBundle: the version is substituted rather than copied. -->
        <Exec Command="sed 's/__VERSION__/$(Version)/g' &quot;$(MSBuildProjectDirectory)/Info.plist&quot; &gt; &quot;$(AotAppBundleDir)/Contents/Info.plist&quot;"/>
        <Copy SourceFiles="Starquake.icns" DestinationFolder="$(AotAppBundleResourcesDir)" SkipUnchangedFiles="true"/>
        <Exec Command="chmod +x &quot;$(AotAppBundleMacOSDir)/Starquake&quot;"/>
        <Exec Command="codesign --force --deep --sign - &quot;$(AotAppBundleDir)&quot;"/>
        <Message Text="Built $(AotAppBundleDir)" Importance="High"/>
    </Target>
</Project>
