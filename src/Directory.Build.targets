<!--
  Stop the incremental build deleting the content it just decided not to re-copy.

  The built .xnb files reach a project's output folder as Content items with
  CopyToOutputDirectory - built in Starquake.Shared, and carried into each head through the
  project reference. The SDK target that copies them skips itself when the destinations are
  already newer than the sources, which on the build after any build that copied them they are.
  A skipped target writes nothing, so it registers nothing in FileWrites, and IncrementalClean
  then deletes every content file as "no longer produced by this build". The next launch dies on
  the first asset it loads, usually Graphics\BootScreen2.

  Declaring what is already in the output folder as a file write says it is still ours. It costs
  one directory enumeration, it does not matter whether the copy ran or was skipped, and it is
  harmless in the projects that have no Content folder - the wildcard simply matches nothing.

  This lives here rather than in Starquake.Shared.csproj because every project that ends up with
  a Content folder needs it, which is the game library and all three heads, and the heads do not
  import that file. See PLAN.md 6.6 for how it was tracked down, and note that
  DisableIncrementalClean is not the answer: it was tried and it made things worse.
-->
<Project>

    <Target Name="KeepBuiltContentOutOfIncrementalClean"
            AfterTargets="CopyFilesToOutputDirectory"
            BeforeTargets="IncrementalClean">
        <ItemGroup>
            <FileWrites Include="$(OutputPath)Content\**\*.*"/>
        </ItemGroup>
    </Target>

</Project>
