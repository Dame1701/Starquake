<!--
  NativeAOT, 64-bit Intel Linux. See "Publishing ahead of time" in BUILD.md.

      dotnet publish Starquake.Linux/Starquake.Linux.csproj -p:PublishProfile=Aot-linux-x64

  This profile has to be run on Linux, on a machine with clang, the zlib headers, and an
  objcopy or llvm-objcopy for the symbol stripping. ILC will cross-compile the managed code
  from a Mac - it emits a correct linux-x64 object file - but the link then fails, because
  macOS clang has no linker that targets Linux. See "Publishing ahead of time" in BUILD.md.
-->
<Project>
    <!--
      No TargetFramework here on purpose. Every project in the solution targets exactly one, so
      naming it would say nothing - and an IDE publishes a profile by passing its properties on
      the command line, where TargetFramework becomes a global property that reaches every
      project in the graph and overrides what each of them chose for itself. See the Gotchas
      section of BUILD.md.
    -->
    <PropertyGroup>
        <PublishProtocol>FileSystem</PublishProtocol>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishAot>true</PublishAot>
        <PublishDir>bin/Publish/linux-x64/</PublishDir>
    </PropertyGroup>
</Project>
