<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ScreenEditor.ViewModels"
        xmlns:sq="clr-namespace:ScreenEditor"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ScreenEditor.MainWindow"
        Title="Starquake ScreenEditor">
    <Design.DataContext>
        <vm:MainWindowViewModel></vm:MainWindowViewModel>
    </Design.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New MapData"
                          Command="{Binding DataType=vm:MainWindowViewModel, Path=NewMapDataCommand}" />
                <MenuItem Header="Load MapData" />
                <MenuItem Header="Save MapData"
                          Command="{Binding DataType=vm:MainWindowViewModel, Path=SaveMapDataAsyncCommand}" />
                <Separator />
                <MenuItem Header="Load TileSet" />
                <Separator />
                <MenuItem Header="Exit" />
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Show Grid" />
                <Separator />
                <MenuItem Header="Show CollisionMap" />
            </MenuItem>
        </Menu>
        <TextBlock />
        <sq:TileSelector></sq:TileSelector>
    </DockPanel>
</Window>