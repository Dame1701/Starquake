<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ScreenEditor.ViewModels"
        xmlns:views="clr-namespace:ScreenEditor.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ScreenEditor.Views.MainWindow"
        Title="Starquake ScreenEditor">
    <Design.DataContext>
        <vm:MainWindowViewModel></vm:MainWindowViewModel>
    </Design.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New MapData"
                          Command="{Binding DataType=vm:MainWindowViewModel, Path=NewMapDataCommand}" />
                <MenuItem Header="Load MapData"
                          Command="{Binding DataType=vm:MainWindowViewModel, Path=LoadMapDataAsyncCommand}" />
                <MenuItem Header="Save MapData"
                          Command="{Binding DataType=vm:MainWindowViewModel, Path=SaveMapDataAsyncCommand}" />
                <Separator />
                <MenuItem Header="Load TileSet"
                          Command="{Binding DataType=vm:MainWindowViewModel, Path=LoadTileSetAsyncCommand}" />
                <Separator />
                <MenuItem Header="Exit" />
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Show Grid">
                    <MenuItem.Icon>
                        <CheckBox
                            Command="{Binding DataType=vm:MainWindowViewModel, Path=ShowGridToggleCommand }"
                            CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Show CollisionMap" />
            </MenuItem>
        </Menu>
        <views:TileSelector TileSet="{Binding DataType=vm:MainWindowViewModel, Path =TileSet, Mode=TwoWay }" />
    </DockPanel>
</Window>