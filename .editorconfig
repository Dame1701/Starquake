# ---------------------------------------------------------------------------------------
# House style for the solution.
#
# Two jobs. The first is to write down the formatting the code already uses, so an editor
# opening a file does not quietly reformat it. The second is to fix the severity of the
# inspections we have agreed to keep clean, so Rider, `dotnet build` and `jb inspectcode`
# all report the same thing and the cleanup we did does not drift back a file at a time.
#
# Severities here are deliberate. An inspection set to `warning` is one we have cleaned up
# and intend to keep at zero. One set to `suggestion` is worth doing but not worth failing
# a build over. One set to `none` is a style we have decided against, written down so it
# stops being re-suggested.
#
# ProjectMercury is the exception throughout, and has its own section at the bottom.
# ---------------------------------------------------------------------------------------

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{csproj,props,targets,config,xml,mgcb}]
indent_size = 4

[*.cs]
charset = utf-8-bom
indent_size = 4

# --- Language style, matching what the code already does -------------------------------

csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# `var` is used freely for locals where the type is obvious and spelled out where it is
# not. Both are fine here, so neither is enforced.
csharp_style_var_for_built_in_types = false:none
csharp_style_var_when_type_is_apparent = true:none
csharp_style_var_elsewhere = false:none

# --- Roslyn inspections we keep at zero -------------------------------------------------

dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0044.severity = warning   # Make field readonly
dotnet_diagnostic.IDE0051.severity = warning   # Remove unused private member
dotnet_diagnostic.IDE0052.severity = warning   # Remove unread private member
dotnet_diagnostic.IDE0059.severity = warning   # Unnecessary assignment of a value
dotnet_diagnostic.IDE0060.severity = warning   # Remove unused parameter

# --- ReSharper inspections we keep at zero ---------------------------------------------
#
# These have no Roslyn equivalent, so they are named by their ReSharper ids. They are the
# categories the cleanup went through: accessibility and mutability tightening, dead code,
# and the three families that tend to hide real bugs rather than untidiness.

resharper_field_can_be_made_read_only_global_highlighting = warning
resharper_field_can_be_made_read_only_local_highlighting = warning
resharper_member_can_be_private_global_highlighting = warning
resharper_member_can_be_protected_global_highlighting = warning
resharper_auto_property_can_be_made_get_only_global_highlighting = warning
resharper_property_can_be_made_init_only_global_highlighting = warning

resharper_unused_member_local_highlighting = warning
resharper_unused_member_global_highlighting = warning
resharper_not_accessed_field_local_highlighting = warning
resharper_not_accessed_field_global_highlighting = warning
resharper_unused_parameter_local_highlighting = warning
resharper_unused_variable_highlighting = warning
resharper_redundant_assignment_highlighting = warning
resharper_invalid_xml_doc_comment_highlighting = warning

# The bug-shaped ones. A hit here is worth reading rather than auto-fixing: each of the
# three has already turned up a real defect in the death animation.
resharper_possible_null_reference_exception_highlighting = warning
resharper_condition_is_always_true_or_false_highlighting = warning
resharper_possible_loss_of_fraction_highlighting = warning

# --- Worth doing, not worth blocking on -------------------------------------------------

resharper_convert_to_primary_constructor_highlighting = suggestion
resharper_for_can_be_converted_to_foreach_highlighting = suggestion
resharper_use_object_or_collection_initializer_highlighting = suggestion
resharper_use_collection_expression_highlighting = suggestion
resharper_merge_into_pattern_highlighting = suggestion
resharper_convert_if_statement_to_null_coalescing_assignment_highlighting = suggestion
resharper_can_simplify_dictionary_lookup_with_try_get_value_highlighting = suggestion
resharper_too_wide_local_variable_scope_highlighting = suggestion

# --- Decided against ---------------------------------------------------------------------
#
# A `?:` is not automatically clearer than the `if` it replaces, and the game's update and
# draw paths are full of short branches that read better spelled out. Left off so it stops
# being offered on every one of them.
resharper_convert_if_statement_to_conditional_ternary_expression_highlighting = none

# ---------------------------------------------------------------------------------------
# ProjectMercury and its content pipeline extension.
#
# Upstream code from 2009, kept as a fork rather than rewritten. It is held to the compiler
# but not to our style: cleaning it would be a large diff through source we did not write
# and would make comparing against upstream harder. Its .csproj also turns Nullable off for
# the same reason. Sources here are Latin-1, not UTF-8, so the charset rule is lifted or an
# editor would rewrite every file's copyright header on save.
# ---------------------------------------------------------------------------------------

[{ProjectMercury,ProjectMercury.ContentPipeline}/**.cs]
charset = unset
trim_trailing_whitespace = false
insert_final_newline = false
