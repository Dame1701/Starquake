<!--
  NativeAOT, 64-bit Windows. See "Publishing ahead of time" in BUILD.md.

      dotnet publish Starquake.Windows\Starquake.Windows.csproj -p:PublishProfile=Aot-win-x64

  Two reasons this one is Windows-only. NativeAOT does not cross-compile and links through the
  MSVC toolchain, so it wants the Visual Studio C++ build tools; and this head's content is built
  by MGCB's WindowsDX platform, which needs the DirectX shader compiler that only Windows has.
-->
<Project>
    <!--
      No TargetFramework here on purpose. Every head targets exactly one, so naming it would say
      nothing - and an IDE publishes a profile by passing its properties on the command line,
      where TargetFramework becomes a global property that reaches every project in the graph.
      ProjectMercury multi-targets net8.0 and net8.0-windows for MGCB's sake; a restore carrying
      a global TargetFramework collapses it to that one framework and writes an assets file with
      no net8.0 target in it, and the next build fails in a way that has nothing to do with what
      was published:

          NETSDK1005: Assets file 'ProjectMercury/obj/project.assets.json' doesn't have a target
          for 'net8.0'

      `dotnet restore` on its own puts that right. See the Gotchas section of BUILD.md.
    -->
    <PropertyGroup>
        <PublishProtocol>FileSystem</PublishProtocol>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishAot>true</PublishAot>
        <PublishDir>bin/Publish/win-x64/</PublishDir>
    </PropertyGroup>
</Project>
