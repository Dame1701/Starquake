<!--
  Every package version the solution uses, in one place.

  MonoGame was pinned in five project files and MessagePack in three, so a version bump
  meant finding each of them and getting them all right - and two of the five MonoGame
  references are different flavours of the same framework, which have to move together or
  the heads stop agreeing with the content pipeline. With central management a bump is one
  line here and the projects keep naming only what they depend on.

  Avalonia is four packages plus Material.Icons.Avalonia, which is what holds the editor at
  11.3 rather than the 11.2 it was generated against; they move together too. 11.3.22 rather
  than the 11.3.8 they sat on is the .NET 10 upgrade's doing, and not for a framework reason:
  the SDK audits transitive packages by default from .NET 10, which turned up a high severity
  advisory against Tmds.DBus.Protocol 0.21.2 - a package nothing here names, pulled in by
  Avalonia.FreeDesktop. Avalonia fixed it themselves by moving to 0.21.3, so taking their patch
  releases is the fix rather than pinning a package of theirs from here. The advisory predates
  the upgrade; only the reporting of it is new.
-->
<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup Label="MonoGame">
        <PackageVersion Include="MonoGame.Content.Builder.Task" Version="3.8.4.1"/>
        <PackageVersion Include="MonoGame.Framework.Content.Pipeline" Version="3.8.4.1"/>
        <PackageVersion Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1"/>
        <PackageVersion Include="MonoGame.Framework.WindowsDX" Version="3.8.4.1"/>
    </ItemGroup>

    <ItemGroup Label="Screen data">
        <PackageVersion Include="MessagePack" Version="3.1.10"/>
    </ItemGroup>

    <ItemGroup Label="ScreenEditor">
        <PackageVersion Include="Avalonia" Version="11.3.22"/>
        <PackageVersion Include="Avalonia.Desktop" Version="11.3.22"/>
        <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.22"/>
        <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.22"/>
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.22"/>
        <PackageVersion Include="Material.Icons.Avalonia" Version="3.0.0-preview3.1"/>
    </ItemGroup>

    <ItemGroup Label="Tests">
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
        <PackageVersion Include="xunit" Version="2.9.2"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2"/>
    </ItemGroup>

</Project>
